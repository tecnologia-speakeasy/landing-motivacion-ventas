# Copia este archivo como `.env.local` y completa los valores.
# En Vercel, define las mismas variables en Project Settings → Environment Variables.

# La misma DATABASE_URL de inventario-speakeasy (copiarla de su .env).
# La landing solo hace SELECT dentro de transacciones de solo lectura, así que
# no puede modificar nada.
# Opcional: usar un usuario con acceso mínimo (scripts/sql/readonly-role.sql).
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/system"

# Programa de la cartera cuyas compras se cuentan
# (Administrativo → Cartera → APRENDE INGLÉS CON SPEAK EASY G2).
CARTERA_PRODUCTO_ID="79e47346-0188-4aa8-b706-818b68442866"

# Opcional: cada cuánto consulta la pantalla (milisegundos, mínimo 1000).
NEXT_PUBLIC_SALES_POLL_MS="2000"
